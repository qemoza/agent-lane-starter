# Copy this file to .env and fill it in. Never commit .env.

# Which adapter in boards/ to use: clickup, trello, github
BOARD=clickup

# How long the agent gets on one task before it is stopped, in seconds
AGENT_TIMEOUT_SECONDS=1800

# How often to check the lane, in seconds
POLL_SECONDS=60

# Where the agent is allowed to work. Point this at the repo it should edit.
# Leave blank to use ./workspace
AGENT_WORKDIR=

# ---- ClickUp ----
CLICKUP_TOKEN=REPLACE_ME
CLICKUP_LIST_ID=REPLACE_ME
CLICKUP_AGENT_STATUS=agent
CLICKUP_REVIEW_STATUS=review

# ---- Trello ----
TRELLO_KEY=REPLACE_ME
TRELLO_TOKEN=REPLACE_ME
TRELLO_AGENT_LIST_ID=REPLACE_ME
TRELLO_REVIEW_LIST_ID=REPLACE_ME

# ---- GitHub ----
GITHUB_TOKEN=REPLACE_ME
GITHUB_REPO=REPLACE_ME/REPLACE_ME
GITHUB_AGENT_LABEL=agent
GITHUB_REVIEW_LABEL=review
